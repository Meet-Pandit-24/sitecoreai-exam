# Database
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/sitecoreai-exam

# JWT
JWT_SECRET=your-secret-key-here

# Email (SendGrid - Free: 100 emails/day)
# Sign up: https://sendgrid.com/free
# Create API key in Settings → API Keys
# Verify sender email in Settings → Senders
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=SG.your-sendgrid-api-key-here
FROM_EMAIL=noreply@yourdomain.com

# Frontend
FRONTEND_URL=https://exam.yourdomain.com

# Server
PORT=5000
NODE_ENV=production
